Form Dict: {'docs': '{"docstatus":0,"doctype":"Memoranda","name":"new-memoranda-rkceyflzyv","__islocal":1,"__unsaved":1,"owner":"Administrator","date":"2025-01-27 06:27:45","custom_to":"Accounts and Administrative Officer","custom_cc":"Accounts and Administrative Officer","custom_subject":"mjsadjkskdskjdaka","custom_content":"<div class=\\"ql-editor read-mode\\"><p>kbvkuavcsjkbasbaksbjaksbaksbaskbaksbaksbkaksbjaksuckaugckquckbwc qwkcabqwsuchac awckabcakciuac qjkcbareiuvibvbwskuwc biwkbefwkefbw</p><p>w bejkuwikbwkbiwenbksweusuebvbswbeue</p><p>\'nbeiwevbccwveuiyvvwi w iewwiueuwfiuwe wewiewuie webvw</p></div>"}', 'method': 'generate_reference_number', 'cmd': 'run_doc_method'}
